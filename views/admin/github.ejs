<%- include('partials/head', { pageTitle: 'Publication GitHub' }) %>
<%- include('partials/nav', { active: 'github' }) %>

<h1 class="admin-title">Publication GitHub</h1>
<p class="admin-subtitle">Envoyez en un clic les actualités, résultats, compositions et photos du site vers votre dépôt GitHub.</p>

<% if (query.saved) { %><p class="flash flash--ok">Identifiants GitHub enregistrés pour cette session.</p><% } %>
<% if (typeof success !== 'undefined') { %><p class="flash flash--ok"><%= success %></p><% } %>
<% if (typeof error !== 'undefined') { %><p class="flash flash--err"><%= error %></p><% } %>

<div class="github-status">
  <div class="github-status__head">
    <svg class="ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.93c.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.12v3.14c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
    <span class="github-status__title">État de la connexion</span>
  </div>
  <p class="github-status__line">
    <% if (configured) { %>
    <span class="badge-issue badge-issue--victoire">Configuré</span>
    Dépôt : <strong><%= config.owner %>/<%= config.repo %></strong>
    <% } else { %>
    <span class="badge-issue badge-issue--defaite">Non configuré</span>
    Renseignez le token et le propriétaire ci-dessous.
    <% } %>
  </p>
  <% if (lastPush) { %>
  <p class="github-status__line github-status__last">Dernière publication : <%= new Date(lastPush).toLocaleString('fr-FR') %></p>
  <% } %>
</div>

<% if (configured) { %>
<form method="post" action="/admin/github/publish" class="github-publish" data-confirm="Envoyer les contenus du site vers le dépôt GitHub ?">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p>Seront envoyés : la base de données (<code>data/db.json</code>) et toutes les photos téléversées (<code>public/uploads/…</code>).</p>
  <button class="btn btn--primary btn--big" type="submit">Publier sur GitHub</button>
</form>
<% } else { %>
<p class="github-publish__hint">Pour configurer : <a href="https://github.com/settings/tokens" target="_blank" rel="noopener">créez un token GitHub</a> avec le droit <strong>Contents (lecture/écriture)</strong>, puis collez-le ci-dessous. Il n'est utilisé que pendant cette session.</p>
<% } %>

<div class="admin-form">
  <h2 class="admin-form__section">Identifiants GitHub</h2>
  <form method="post" action="/admin/github/update-code">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <div class="field">
        <label class="field__label" for="token">Token GitHub (fine-grained, droit Contents)</label>
        <input class="field__input" id="token" name="token" type="password" autocomplete="off" placeholder="github_pat_…">
      </div>
      <div class="field">
        <label class="field__label" for="owner">Propriétaire du dépôt (nom d’utilisateur ou organisation)</label>
        <input class="field__input" id="owner" name="owner" type="text" value="<%= config.owner %>" placeholder="ex. HC-Dinan-Quevert">
      </div>
      <div class="field">
        <label class="field__label" for="repo">Nom du dépôt</label>
        <input class="field__input" id="repo" name="repo" type="text" value="<%= config.repo %>" placeholder="hc-dinan-quevert">
      </div>
    </div>
    <p class="field__hint">Laissez le token vide pour conserver la configuration actuelle.</p>
    <div class="form-actions">
      <button class="btn btn--primary" type="submit">Enregistrer les identifiants</button>
    </div>
  </form>
</div>

<%- include('partials/foot') %>
