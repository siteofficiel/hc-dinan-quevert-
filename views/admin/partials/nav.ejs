<div class="admin-shell">
  <header class="admin-topbar">
    <a class="admin-topbar__brand" href="/admin">
      <img src="/img/logo.jpg" alt="" width="34" height="30">
      <span>Administration<br><small><%= site.nomCourt %></small></span>
    </a>
    <div class="admin-topbar__actions">
      <a class="btn btn--outline btn--sm" href="/" target="_blank" rel="noopener">Voir le site</a>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost-dark btn--sm" type="submit">Déconnexion</button>
      </form>
    </div>
  </header>

  <div class="admin-body">
    <nav class="admin-nav" aria-label="Sections d’administration">
      <% sections.forEach(s => { %>
      <a class="admin-nav__item <%= active === s.key ? 'is-active' : '' %>" href="<%= s.href %>">
        <svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="<%= s.icon %>"/></svg>
        <span class="admin-nav__label"><%= s.label %></span>
        <span class="admin-nav__desc"><%= s.desc %></span>
      </a>
      <% }) %>
    </nav>

    <main class="admin-content" id="contenu">
