<% const nav = [
  { href: '/', label: 'Accueil', key: '/' },
  { href: '/club', label: 'Le club', key: '/club' },
  { href: '/equipes', label: 'Équipes', key: '/equipes' },
  { href: '/n3', label: 'N3', key: '/n3' },
  { href: '/actualites', label: 'Actualités', key: '/actualites' },
  { href: '/photos', label: 'Photos', key: '/photos' },
]; %>

<div class="demo-bar" id="demoBar" role="note">
  <span><strong>Site de démonstration.</strong> Les textes, résultats, effectifs et photos sont des exemples, à remplacer par les contenus officiels du club.</span>
  <button type="button" class="demo-bar__close" id="demoBarClose" aria-label="Fermer ce bandeau">✕</button>
</div>

<header class="site-header" id="siteHeader">
  <div class="topbar">
    <div class="container topbar__inner">
      <p class="topbar__item"><svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg><%= site.salle %></p>
      <p class="topbar__item topbar__item--hide"><svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg><%= site.telephone %></p>
      <div class="topbar__socials">
        <a href="<%= site.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg class="ic" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.3-1.4 1.5-1.4h1.4V5.5c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5v2.3H8.6V14H11v7h2.5z"/></svg></a>
        <a href="<%= site.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
        <a href="<%= site.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><svg class="ic" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.8-.5-5.6c-.3-1-1.1-1.8-2.1-2C18.6 4 12 4 12 4s-6.6 0-8.4.4c-1 .2-1.8 1-2.1 2C1 8.2 1 12 1 12s0 3.8.5 5.6c.3 1 1.1 1.8 2.1 2 1.8.4 8.4.4 8.4.4s6.6 0 8.4-.4c-1 0 0 0 0 0 1-.2 1.8-1 2.1-2 .5-1.8.5-5.6.5-5.6zM9.8 15.5v-7l6 3.5-6 3.5z"/></svg></a>
      </div>
    </div>
  </div>

  <div class="container header-main">
    <a class="brand" href="/" aria-label="<%= site.nomCourt %> — accueil">
      <span class="brand__logo"><img src="/img/logo.jpg" alt="Logo <%= site.nomCourt %>" width="48" height="42"></span>
      <span class="brand__text">
        <span class="brand__name"><%= site.nomCourt %></span>
        <span class="brand__sub"><%= site.sousTitre %></span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        <% nav.forEach(item => { %>
        <li>
          <a href="<%= item.href %>" class="<%= (path === item.href) ? 'is-active' : '' %>"><%= item.label %></a>
        </li>
        <% }) %>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn--adherent" href="/adherents">
        <svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
        Espace adhérents
      </a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mobileNav" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobileNav" aria-label="Navigation mobile">
    <ul>
      <% nav.forEach(item => { %>
      <li><a href="<%= item.href %>" class="<%= (path === item.href) ? 'is-active' : '' %>"><%= item.label %></a></li>
      <% }) %>
      <li><a href="/adherents" class="mobile-nav__cta">Espace adhérents</a></li>
      <li><a href="/admin/login" class="mobile-nav__admin">Espace administrateur</a></li>
    </ul>
  </nav>
</header>
