<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-col--brand">
      <a class="brand brand--footer" href="/">
        <span class="brand__logo brand__logo--footer"><img src="/img/logo.jpg" alt="Logo <%= site.nomCourt %>" width="56" height="50"></span>
        <span class="brand__text">
          <span class="brand__name"><%= site.nomCourt %></span>
          <span class="brand__sub"><%= site.sousTitre %></span>
        </span>
      </a>
      <p class="footer-about"><%= site.sloganDetail %></p>
      <div class="footer-socials">
        <a href="<%= site.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg class="ic" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.3-1.4 1.5-1.4h1.4V5.5c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5v2.3H8.6V14H11v7h2.5z"/></svg></a>
        <a href="<%= site.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
        <a href="<%= site.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><svg class="ic" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.8-.5-5.6c-.3-1-1.1-1.8-2.1-2C18.6 4 12 4 12 4s-6.6 0-8.4.4c-1 .2-1.8 1-2.1 2C1 8.2 1 12 1 12s0 3.8.5 5.6c.3 1 1.1 1.8 2.1 2 1.8.4 8.4.4 8.4.4s6.6 0 8.4-.4c1-.2 1.8-1 2.1-2 .5-1.8.5-5.6.5-5.6zM9.8 15.5v-7l6 3.5-6 3.5z"/></svg></a>
      </div>
    </div>

    <div class="footer-col">
      <h2 class="footer-title">Le club</h2>
      <ul class="footer-links">
        <li><a href="/club">Présentation &amp; histoire</a></li>
        <li><a href="/equipes">Nos équipes</a></li>
        <li><a href="/n3">Équipe N3</a></li>
        <li><a href="/actualites">Actualités</a></li>
        <li><a href="/photos">Photos</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-title">Contact</h2>
      <ul class="footer-links footer-links--contact">
        <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg><%= site.adresse %></li>
        <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg><%= site.telephone %></li>
        <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
        <li><svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg><a href="<%= site.salleLien %>" target="_blank" rel="noopener"><%= site.salle %></a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-title">Accès rapide</h2>
      <ul class="footer-links">
        <li><a href="/adherents" class="footer-link--strong">Espace adhérents</a></li>
        <li><a href="/compositions">Compositions du week-end</a></li>
        <li><a href="/resultats">Résultats</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/confidentialite">Politique de confidentialité</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-partners">
    <h2 class="footer-title footer-title--partners">Nos partenaires</h2>
    <ul class="partners-list">
      <% (site.partenaires || []).forEach(p => { %>
      <li class="partner-badge"><%= p %></li>
      <% }) %>
    </ul>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p>© <%= new Date().getFullYear() %> <%= site.nomComplet %> — Rink hockey · Quévert · Dinan. Site réalisé pour le club.</p>
      <a href="/admin/login" class="btn btn--admin-access">
        <svg class="ic" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z"/><path d="m9 12 2 2 4-4"/></svg>
        Espace administrateur
      </a>
    </div>
  </div>
</footer>

<script src="/js/main.js" defer></script>
</body>
</html>
